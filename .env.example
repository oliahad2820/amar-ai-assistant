# ============================================================
# Amar AI Assistant - Environment Configuration
# Copy to `.env` (or `backend/.env`) and fill your values.
# NEVER commit `.env` to GitHub!
# ============================================================

# Assistant Identity
ASSISTANT_NAME="আমার এআই"
OWNER_NAME="অলি আহাদ"
TIMEZONE="Asia/Dhaka"

# Gemini API (Free Tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-4-hydrogen"

# Optional API Auth Token (protects backend if hosted publicly)
BACKEND_API_TOKEN=""

# Allowed Frontend Origins (comma-separated: localhost, GitHub Pages, custom domain)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://oliahad2820.github.io"

# Email Integration (Gmail App Password OR Custom Domain IMAP/SMTP)
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASS=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"

# Facebook Page Integration (Official Meta Graph API)
FB_PAGE_ID=""
FB_PAGE_ACCESS_TOKEN=""
FB_VERIFY_TOKEN="amar_ai_fb_verify_token"
FB_APP_SECRET=""

# Personal Facebook Safe Mode (parses Facebook email alerts via IMAP)
FB_PARSE_EMAIL_ALERTS="true"

# Proactive Check-in Interval (minutes)
CHECKIN_INTERVAL_MINUTES="60"
