# ============================================================
# Amar AI Assistant - Environment Configuration
# Copy to `.env` (or `backend/.env`) and fill your values.
# NEVER commit `.env` to GitHub!
# ============================================================

# Assistant Identity
ASSISTANT_NAME="আমার এআই"
OWNER_NAME="অলি আহাদ"
TIMEZONE="Asia/Dhaka"

# ------------------------------------------------------------
# 100% FREE & UNLIMITED AI PROVIDER CHAIN
# Order tried automatically: ollama -> gemini -> openai_compat -> local
# ------------------------------------------------------------
AI_PROVIDER_ORDER="ollama,gemini,openai_compat"

# Option 1 (Truly Unlimited & $0 Forever): Local Ollama on your Mac/PC
# Install: brew install ollama && ollama pull qwen2.5:7b
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b"

# Option 2 (Free Cloud Tier, No Credit Card): Google AI Studio
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-4-hydrogen"

# Option 3 (Free Cloud Fallback): Groq / OpenRouter :free / Cerebras
OPENAI_COMPAT_BASE_URL="https://api.groq.com/openai/v1"
OPENAI_COMPAT_API_KEY=""
OPENAI_COMPAT_MODEL="llama-3.3-70b-versatile"

# Optional API Auth Token (protects backend if exposed via Cloudflare Tunnel / Render)
BACKEND_API_TOKEN=""

# Allowed Frontend Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://oliahad2820.github.io"

# Email Integration (Gmail App Password OR Custom Domain IMAP/SMTP)
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASS=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"

# Facebook Page Integration (Official Meta Graph API)
FB_PAGE_ID=""
FB_PAGE_ACCESS_TOKEN=""
FB_VERIFY_TOKEN="amar_ai_fb_verify_token"
FB_APP_SECRET=""

# Personal Facebook Safe Mode (parses Facebook email alerts via IMAP)
FB_PARSE_EMAIL_ALERTS="true"

# Proactive Check-in Interval (minutes)
CHECKIN_INTERVAL_MINUTES="60"
